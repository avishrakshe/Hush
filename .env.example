# ─────────────────────────────────────────────────────────────────────────────
# Hush — environment. Run `pnpm keys` to create .env with fresh role keys,
# or copy this file to .env and fill it in. NEVER commit .env.
# These are TESTNET keys only — do not reuse them on mainnet.
# ─────────────────────────────────────────────────────────────────────────────

# Network
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
# Log scans. The public Fuji RPC above caps eth_getLogs at 100 blocks (the default), so long scans (operator audit
# index, treasury history) take thousands of requests. Faster: scan through a wide-range RPC. Keep FUJI_RPC_URL on an
# archive RPC like the official one — publicnode prunes old state, which decrypting outgoing eERC transfers needs.
# FUJI_LOGS_RPC_URL=https://avalanche-fuji-c-chain-rpc.publicnode.com
# LOGS_MAX_RANGE=50000

# Role keys (0x-prefixed 32-byte hex). Only DEPLOYER needs faucet AVAX:
# `pnpm fund:fuji` forwards a small amount of AVAX to every other role.

# Deploys contracts and owns the eERC contract (sets the auditor)
DEPLOYER_PRIVATE_KEY=
# eERC auditor (compliance view); its eERC key is derived from this wallet
AUDITOR_PRIVATE_KEY=
# Human owner / treasury that funds the agents
OWNER_PRIVATE_KEY=
# Agent "Atlas" (public x402 baseline)
ATLAS_PRIVATE_KEY=
# Agent "Veil" (hush-credit)
VEIL_PRIVATE_KEY=
# API provider; the facilitator holds it to decrypt top-ups and send refunds
PROVIDER_PRIVATE_KEY=
# Gas key for commitBatch / x402 settlement
FACILITATOR_PRIVATE_KEY=
# v2: Hush Desk (market maker: quotes, custody, settle-outs; its own eERC key)
DESK_PRIVATE_KEY=
# v2: "AlphaKing" — a signal provider whose claimed track record fails verification (demo)
ALPHAKING_PRIVATE_KEY=
# v2: "Mirror" — copycat bot that trades on what it reads from public chain data (demo)
MIRROR_PRIVATE_KEY=
# v2: MockStockOracle updater used by apps/price-bot
PRICEBOT_PRIVATE_KEY=
# v2: commits Proof of Alpha chain heads to HushAlpha for SignalCo + AlphaKing (set via HushAlpha.setCommitter)
COMMITTER_PRIVATE_KEY=

# AVAX forwarded to each role by `pnpm fund:fuji`
FUND_AMOUNT_AVAX=0.05

# Services (defaults shown)
# FACILITATOR_PORT=4022
# PROVIDER_PORT=4021
# FACILITATOR_URL=http://localhost:4022
# PROVIDER_URL=http://localhost:4021
# Bearer token for the facilitator's provider-console endpoints (/admin/*); `pnpm keys` generates one
PROVIDER_ADMIN_TOKEN=
# Facilitator tuning
# BATCH_INTERVAL_SECONDS=120
# CREDIT_TTL_SECONDS=604800
# EXPIRY_INTERVAL_SECONDS=60

# v2 price bot (synthetic, seeded, mean-reverting random walk; defaults shown)
# PRICE_INTERVAL_SECONDS=60
# PRICE_SEED=42
# v2 signals: horizon must be >= 2 x the Proof-of-Alpha epoch (default 1200 on Fuji, 120 locally)
# SIGNAL_PRICE=$0.02
# SIGNAL_HORIZON_SECONDS=1200

# Snowtrace (Routescan) verification — any non-empty string works for the free tier
SNOWTRACE_API_KEY=snowtrace

# Mainnet (pnpm deploy:mainnet): a separate, funded key — prefer passing it on the command line over storing it here.
# The script is a dry run unless CONFIRM_MAINNET=yes. WITH_ALPHA=1 also deploys HushAlpha.
# MAINNET_DEPLOYER_PRIVATE_KEY=
# CONFIRM_MAINNET=

# Web (apps/web/.env.local) — where the demo stack runs; defaults shown
# NEXT_PUBLIC_OPERATOR_URL=http://localhost:4040
# NEXT_PUBLIC_DESK_URL=http://localhost:4023
# NEXT_PUBLIC_MIRROR_URL=http://localhost:4033
# NEXT_PUBLIC_LOCAL_RPC_URL=http://127.0.0.1:8545
# Same RPC choice for the browser (baked in at build time):
# NEXT_PUBLIC_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# NEXT_PUBLIC_LOGS_MAX_RANGE=100

# Agents (apps/agent): AGENT_BRAIN=rules|claude · ANTHROPIC_API_KEY for the Claude brain
# ANTHROPIC_API_KEY=
