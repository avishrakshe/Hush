{
  "name": "@hush/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Hush contracts: vendored eERC (converter), MockUSDC (EIP-3009), HushRegistry, HushLedger",
  "license": "MIT",
  "scripts": {
    "compile": "hardhat compile",
    "export": "tsx scripts/export-abis.mts",
    "test": "hardhat test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "keys": "tsx scripts/gen-keys.mts",
    "node": "hardhat node",
    "fund:local": "tsx scripts/fund-roles.mts --local",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "prove:local": "tsx scripts/prove-eerc.mts --local",
    "fund:fuji": "tsx scripts/fund-roles.mts",
    "deploy:fuji": "hardhat run scripts/deploy.ts --network fuji",
    "verify:fuji": "hardhat run scripts/verify.ts --network fuji",
    "prove:fuji": "tsx scripts/prove-eerc.mts",
    "status": "tsx scripts/status.mts",
    "status:local": "tsx scripts/status.mts --local"
  },
  "devDependencies": {
    "@avalabs/eerc-sdk": "1.0.2",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/merkle-tree": "^1.0.8",
    "@tanstack/react-query": "^5.104.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.4",
    "chai": "^4.5.0",
    "dotenv": "^16.6.1",
    "ethers": "^6.17.0",
    "hardhat": "^2.29.1",
    "hardhat-gas-reporter": "^2.3.0",
    "react": "^19.3.0",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typechain": "^8.3.2",
    "typescript": "~5.9.3",
    "viem": "^2.56.9",
    "wagmi": "^2.19.5"
  }
}
